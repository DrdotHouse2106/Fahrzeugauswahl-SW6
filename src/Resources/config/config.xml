<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>Fahrzeug-Schnellauswahl</title>

        <input-field type="bool">
            <name>active</name>
            <label>In diesem Verkaufskanal aktivieren</label>
            <helpText>Nur wenn aktiviert, wird die Kachel-Leiste angezeigt UND der globale Kategoriefilter angewendet. Die Konfiguration ist pro Verkaufskanal möglich – oben den gewünschten Verkaufskanal auswählen.</helpText>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Eigenschaftsgruppen</title>

        <component name="sw-entity-single-select">
            <name>propertyGroupIdA</name>
            <entity>property_group</entity>
            <label>Eigenschaftsgruppe „Geeignet für“</label>
        </component>

        <component name="sw-entity-single-select">
            <name>propertyGroupIdB</name>
            <entity>property_group</entity>
            <label>Eigenschaftsgruppe „Geeignet für A-Typ“</label>
        </component>
    </card>

    <card>
        <title>Darstellung</title>

        <input-field type="int">
            <name>maxOptions</name>
            <label>Maximale Anzahl Kacheln</label>
            <defaultValue>60</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>showGroupLabel</name>
            <label>Gruppennamen als Zwischenüberschrift zeigen</label>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>
</config>
