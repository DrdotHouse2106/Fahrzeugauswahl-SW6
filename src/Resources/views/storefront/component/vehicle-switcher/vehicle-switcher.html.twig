{% block component_vehicle_switcher %}
    <div class="vehicle-switcher"
         data-vehicle-switcher="true"
         data-vehicle-switcher-options="{{ {
             selectRoute: path('frontend.vehicle-switcher.select'),
             activeClass: 'is-active',
             storageKey: 'vehicleSwitcherOptionId'
         }|json_encode }}">

        {% block component_vehicle_switcher_inner %}
            <div class="vehicle-switcher__track" role="group" aria-label="{{ 'vehicle-switcher.ariaLabel'|trans|sw_sanitize }}">

                {% block component_vehicle_switcher_all %}
                    {% if showAllOption %}
                        <button type="button"
                                class="vehicle-switcher__item vehicle-switcher__item--all{% if activeOptionId is null %} is-active{% endif %}"
                                data-vehicle-switcher-item
                                data-option-id=""
                                aria-pressed="{{ activeOptionId is null ? 'true' : 'false' }}">
                            {%- if allOptionLabel is not empty -%}
                                {{ allOptionLabel|sw_sanitize }}
                            {%- else -%}
                                {{ 'vehicle-switcher.showAll'|trans|sw_sanitize }}
                            {%- endif -%}
                        </button>
                    {% endif %}
                {% endblock %}

                {% block component_vehicle_switcher_items %}
                    {% set currentGroupId = null %}
                    {% for option in options %}
                        {% if option.groupId != currentGroupId %}
                            {% set currentGroupId = option.groupId %}
                            {% set groupLabel = groupLabels[option.groupId]|default('') %}
                            {% if groupLabel is not empty %}
                                <span class="vehicle-switcher__group-label">{{ groupLabel|sw_sanitize }}</span>
                            {% endif %}
                        {% endif %}

                        <button type="button"
                                class="vehicle-switcher__item{% if option.id == activeOptionId %} is-active{% endif %}"
                                data-vehicle-switcher-item
                                data-option-id="{{ option.id }}"
                                title="{{ (option.translated.name ?? option.name)|sw_sanitize }}"
                                aria-pressed="{{ option.id == activeOptionId ? 'true' : 'false' }}">
                            {{ (option.translated.name ?? option.name)|sw_sanitize }}
                        </button>
                    {% endfor %}
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
